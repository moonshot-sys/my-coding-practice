{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build project", // <- 이 label 이름을 확인
      "command": "g++",        // 사용하는 컴파일러 명령어
      "args": ["-g", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}